# Runtime artifacts — the skills GENERATE these into a target project; they are never authored here.
ledger.json
graph.json
*.skill
.audit/
docs/audits/

# NOTE what is deliberately NOT ignored: plugins/. It is build output, and it is committed, because
# a marketplace installs straight from the repo — there is nowhere else for it to live. That is what
# `python scripts/build.py --check` is for: it fails CI if the committed output drifts from src/.

# scripts/preview_map.py renders here for the manual browser pass, and the Playwright MCP drops
# snapshots/screenshots in its own dir. Both are dev scratch, like every other runtime artifact.
.preview/
.playwright-mcp/

node_modules/
__pycache__/
.ruff_cache/
*.pyc
.venv/
venv/
.DS_Store

# `scripts/run_evals.py --execute` writes its report here by default, and the documented
# invocation is run FROM the repo root. It lands even on the runner-unavailable path (exit 3),
# so a developer who merely tries `--execute` on a machine without credentials leaves one — and a
# release commit's `git add -A` would carry a machine-specific, timestamped artifact into the tree.
# Same rule as every line above: the tool generates it, nobody authors it.
eval-report.json
